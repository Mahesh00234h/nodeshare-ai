# Security & Token Settings
NODE_ENROLLMENT_SECRET=dev-enrollment-token
CONTROLLER_API_KEY=sk-cluster-controller-secret-key

# Infrastructure & Storage (MongoDB Atlas)
DATABASE_URL=mongodb://localhost:27017/nodeshare_db
MONGODB_URL=mongodb://localhost:27017/nodeshare_db
MONGODB_DB_NAME=nodeshare_db
REDIS_URL=redis://localhost:6379/0

# Server Ports (Render web services use PORT=10000)
PORT=10000
HTTP_PORT=10000
GRPC_PORT=50051

# Health & Telemetry Thresholds
HEARTBEAT_INTERVAL_SECONDS=5
HEARTBEAT_TIMEOUT_SECONDS=20

# System Logging
LOG_LEVEL=INFO
